# =============================================================================
# Bententrade — шаблон переменных окружения
# Скопируйте этот файл в .env (локально) или вставьте строки в Railway → Web-сервис → Variables
# Секреты НЕ коммитьте. Для генерации токенов: npm run env:secrets
# =============================================================================

# --- PostgreSQL ---
# На Railway (Web-сервис): только Reference → DATABASE_URL из сервиса Postgres (хост *.railway.internal).
# С компьютера .internal НЕ работает — для локального .env возьмите DATABASE_PUBLIC_URL из Postgres → Connect.
DATABASE_URL=

# Опционально: таймаут подключения (мс), если запросы к БД «висят»
# PG_CONNECTION_TIMEOUT_MS=15000

# Отключить SSL к БД только если провайдер требует (по умолчанию в коде SSL включён для Railway)
# DATABASE_SSL=false

# --- Защита API (Bearer-токен; должен совпадать с VITE_API_TOKEN на фронте при сборке) ---
API_TOKEN=

# --- Админ-панель на сайте (пароль для входа) ---
ADMIN_PASSWORD=

# --- Telegram-уведомления о заказах (необязательно) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Фронтенд (подставляются в Vite при npm run build; для продакшена задайте в CI/Railway) ---
VITE_API_BASE_URL=/api
VITE_API_TOKEN=

# --- Канонический URL сайта (для пререндера SEO; по умолчанию в скрипте bententrade.uz) ---
# SITE_ORIGIN=https://bententrade.uz

# --- Порт (Railway задаёт сам; локально можно не указывать) ---
# PORT=3000
